<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio de Clara</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; color: white; padding: 2rem; }
        .container { max-width: 800px; margin: 0 auto; background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border-radius: 20px; padding: 3rem; box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
        h1 { font-size: 2.5rem; margin-bottom: 1rem; text-align: center; }
        .profile { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 2rem; }
        .avatar { width: 120px; height: 120px; border-radius: 50%; background: white; object-fit: cover; border: 4px solid rgba(255,255,255,0.3); }
        .info h2 { font-size: 1.8rem; margin-bottom: 0.5rem; }
        .info p { margin-bottom: 0.5rem; opacity: 0.9; }
        .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
        .tag { background: rgba(255,255,255,0.2); padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.9rem; }
        nav { display: flex; justify-content: center; gap: 1rem; margin-top: 2rem; }
        nav a { color: white; text-decoration: none; padding: 0.8rem 1.5rem; background: rgba(255,255,255,0.2); border-radius: 10px; transition: all 0.3s; }
        nav a:hover { background: rgba(255,255,255,0.3); transform: translateY(-2px); }
    </style>
</head>
<body>
    <div class="container">
        <h1>Bonjour, je m'appelle {{ name }}</h1>
        
        <div class="profile">
            <img src="/assets/images/avatar.jpg" alt="Avatar de Clara" class="avatar">
            <div class="info">
                <h2>{{ age }} ans</h2>
                <p>📍 {{ location }}</p>
                <p>🎓 {{ study }}</p>
                <div class="tags">
                    {% for passion in passions %}
                    <span class="tag">{{ passion }}</span>
                    {% endfor %}
                </div>
            </div>
        </div>

        <nav>
            <a href="{{ path('app_about') }}">À propos</a>
            <a href="{{ path('app_contact') }}">Contact</a>
        </nav>
    </div>
</body>
</html>
